{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Postgres under gdb",
      "type": "cppdbg",
      "request": "launch",
      "program": "${env:HOME}/pgsql-dev/bin/postgres",
      "args": ["-D", "${env:HOME}/pgdata"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [
        { "name": "PATH", "value": "${env:HOME}/pgsql-dev/bin:${env:PATH}" },
        { "name": "LD_LIBRARY_PATH", "value": "${env:HOME}/pgsql-dev/lib:${env:LD_LIBRARY_PATH}" }
      ],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "build-postgres",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "logging": { "trace": true, "traceResponse": true }
    },
    {
      "name": "Attach to running postgres",
      "type": "cppdbg",
      "request": "attach",
      "program": "${env:HOME}/pgsql-dev/bin/postgres",
      "processId": "${command:pickProcess}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        { "description": "Enable pretty-printing for gdb", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
